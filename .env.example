# Ogene — environment variables
#
# Copy to `.env.local` and fill in. Never commit the filled-in file.
#
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: the `VITE_` prefix is not cosmetic.
#
# Vite inlines every `VITE_`-prefixed variable it sees referenced into the
# JavaScript bundle that ships to the browser. Anyone can read them with
# devtools. Only put values here that are safe to be fully public.
#
# Anything secret MUST NOT have the `VITE_` prefix. Server-side keys belong in
# the "server-only" block at the bottom, and are read by Vercel serverless
# functions and Supabase Edge Functions — never by React code.
# ─────────────────────────────────────────────────────────────────────────────


# ── Public: safe to ship to the browser ──────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/publishable key. Public by design — Row Level Security is the
# real access boundary, not this key. Safe in the bundle.
VITE_SUPABASE_ANON_KEY=

# Flutterwave PUBLIC key (FLWPUBK-...). Safe in the bundle by design; it is what
# the payment modal is initialised with. Used only on the APC payment page.
VITE_FLUTTERWAVE_PUBLIC_KEY=

# Canonical site origin, used to build password-reset redirect links.
# Falls back to window.location.origin when unset.
VITE_APP_URL=http://localhost:5173


# ── Server-only: NEVER prefix these with VITE_ ───────────────────────────────
# Set in the Vercel project settings and the Supabase Edge Function secrets.
# If any of these ever appears with a VITE_ prefix, it is compromised the moment
# a line of client code reads it.

# Same project URL as above, for serverless functions.
SUPABASE_URL=

# Service-role key. Bypasses ALL Row Level Security. Full read/write on every
# table. Treat as a root password.
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave SECRET key (FLWSECK-...). Used server-side only, to verify that a
# transaction the browser claims succeeded actually did.
FLUTTERWAVE_SECRET_KEY=

# Flutterwave encryption key. Server-side only.
FLUTTERWAVE_ENCRYPTION_KEY=

# Shared secret configured on the Flutterwave webhook, checked against the
# `verif-hash` header so forged webhook calls are rejected.
FLUTTERWAVE_WEBHOOK_HASH=
